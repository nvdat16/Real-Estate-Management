# Biến môi trường cho docker compose ở gốc repo (PLAN task 0.7).
# Sao chép thành .env rồi sửa. Không commit .env.
#
# Sinh JWT_SECRET_KEY:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=development

# Bắt buộc: compose sẽ dừng nếu biến này trống.
JWT_SECRET_KEY=thay-bang-gia-tri-sinh-ngau-nhien

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=real_estate
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Cổng publish ra máy chủ
API_PORT=8000
FRONTEND_PORT=5173
HTTP_PORT=8080
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
