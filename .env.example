# Biến môi trường cho docker compose ở gốc repo (PLAN task 0.7).
# Sao chép thành .env rồi sửa. Không commit .env.
#
# Sinh JWT_SECRET_KEY:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=development

# Bắt buộc: compose sẽ dừng nếu biến này trống.
JWT_SECRET_KEY=thay-bang-gia-tri-sinh-ngau-nhien

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=real_estate
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Cổng publish ra máy chủ
API_PORT=8000
FRONTEND_PORT=5173
HTTP_PORT=8080
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# Địa chỉ giao diện dùng trong liên kết email; bỏ trống thì compose lấy http://localhost:$HTTP_PORT.
# PUBLIC_APP_URL=https://bds.example.com

# Mạng compose. Chỉ đổi khi subnet bị trùng với mạng khác trên máy;
# NGINX_IP phải nằm trong DOCKER_SUBNET và ngoài DOCKER_IP_RANGE.
DOCKER_SUBNET=172.28.0.0/24
DOCKER_IP_RANGE=172.28.0.128/25
NGINX_IP=172.28.0.10
