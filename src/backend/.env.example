# Cấu hình cho backend khi chạy ngoài docker compose.
# Khi chạy bằng compose, các biến này được truyền từ .env ở gốc repo.

APP_NAME=Real Estate Management
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/real_estate

REDIS_URL=redis://redis:6379/0
# Broker Celery ở database Redis riêng với cache/rate limit.
CELERY_BROKER_URL=redis://redis:6379/1

# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=thay-bang-gia-tri-sinh-ngau-nhien
JWT_ALGORITHM=HS256

# Kho tệp riêng tư (hợp đồng PDF, chứng từ, tệp xuất)
FILE_STORAGE_DIR=/var/lib/rem/files

# SMTP dev: MailHog trong compose
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=Real Estate Management <no-reply@demo.com>
# Có thể để trống khi dùng MailHog
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false

# Địa chỉ giao diện, dùng dựng liên kết trong email (đặt lại mật khẩu...)
PUBLIC_APP_URL=http://localhost:8080

# Database dùng cho integration test. Test có marker `integration` sẽ tự bỏ qua
# nếu biến này trống. CI đặt biến này trỏ tới service postgres của job.
TEST_DATABASE_URL=
